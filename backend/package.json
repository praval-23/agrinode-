{
  "name": "agrinode-api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API foundation for AgriNode",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "import:supabase": "tsx scripts/import-json-to-supabase.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3"
  }
}
